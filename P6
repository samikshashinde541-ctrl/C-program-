check whether a number is prime 
#include <stdio.h>

int main() 
{
    int n = 29, i, prime = 1;

    if (n < 2)
        prime = 0;

    for (i = 2; i <= n / i; i++) {
        if (n % i == 0) {
            prime = 0;
            break;
        }
    }

    if (prime)
        printf("Prime number");
    else
        printf("Not a prime number");

    return 0;
}
