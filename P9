find average of even number from 1 to 10
#include <stdio.h>

int main() 
{
    int i, sum = 0, count = 0;
    float avg;

    for (i = 1; i <= 10; i++) {
        if (i % 2 == 0) {
            sum += i;
            count++;
        }
    }

    avg = (float)sum / count;
    printf("Average = %.2f", avg);

    return 0;
}
